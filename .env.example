# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE GESTIÓN DE INVENTARIO
# Archivo de Ejemplo: Copiar a .env y ajustar según el entorno local/producción
# ==============================================================================

# Puerto del Servidor Backend
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Configuración de Base de Datos
# ------------------------------------------------------------------------------
# Opción A: PostgreSQL (Configuración por defecto)
DB_URL=jdbc:postgresql://localhost:5432/inventario_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Opción B: MySQL / MariaDB (Alternativa si se prefiere MySQL)
# DB_URL=jdbc:mysql://localhost:3306/inventario_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# Hibernate / JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# Configuración de Seguridad y Tokens JWT
# ------------------------------------------------------------------------------
# La clave secreta debe tener un tamaño mínimo de 256 bits (32 caracteres / bytes)
JWT_SECRET=claveSecretaSuperSeguraParaFirmarTokensJWTInventario2026!Key256Bit
# Tiempo de expiración del token en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# Configuración de CORS (Cross-Origin Resource Sharing)
# Permitir específicamente el puerto 5500 donde corre el Frontend (Live Server)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
